
' ============================================================
' GENERIC PATTERN CONSTRUCTOR
' ============================================================

!procedure $pattern($name, $style, $variant="")

    !$tag = $style

    !if $variant == "main"
        !$tag = $style + "-main"
    !endif

    rectangle "$name" as $name <<$tag>>

!endprocedure

' ============================================================
' AESTHETICS
' ============================================================

!procedure $Challenge($variant="")
    $pattern("challenge", "a-mda", $variant)
!endprocedure

